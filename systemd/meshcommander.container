[Unit]
Description=MeshCommander Intel AMT Management Web UI
After=network-online.target
Wants=network-online.target

[Container]
AutoUpdate=registry
ContainerName=meshcommander
Image=ghcr.io/cuppett/meshcommander:latest
PublishPort=127.0.0.1:3001:3000
Volume=/home/scuppett/container-storage/meshcommander:/data:Z

[Service]
ExecStartPre=-/usr/bin/podman pull ghcr.io/cuppett/meshcommander:latest
Restart=always

[Install]
WantedBy=default.target
